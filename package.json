{
  "name": "xrpl-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI agent managing a self-sovereign XRP wallet on the XRPL Testnet (DEX + XLS-20 NFTs)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:testnet": "jest --runInBand tests/integration",
    "faucet": "ts-node scripts/createTestnetWallet.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@langchain/core": "0.3.40",
    "@langchain/openai": "0.4.5",
    "dotenv": "^16.4.7",
    "langchain": "0.3.19",
    "xrpl": "^4.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "overrides": {
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  }
}
