# XRPL Testnet only. Never point this at Mainnet.
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233

# Family seed (sXXXX...) of the agent wallet. Generate one with `npm run faucet`.
XRPL_SEED=

# API key used by the LangChain tool-calling agent (OpenAI or any OpenAI-compatible provider).
OPENAI_API_KEY=

# Optional overrides
# Point at an OpenAI-compatible gateway, e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
MAX_SPEND_XRP=50
